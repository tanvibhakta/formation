#!/usr/bin/env zsh

###############################################################################
# ERROR: Let the user know if the script fails
###############################################################################

trap 'ret=$?; test $ret -ne 0 && printf "\n   \e[31m\033[0m  Formation failed  \e[31m\033[0m\n" >&2; exit $ret' EXIT

set -e

###############################################################################
# SETUP: Code directory and self-relocation
###############################################################################

mkdir -p "$HOME/Code"

# Resolve the directory this script is running from
this_dir="$(cd "$(dirname "$0")" && pwd)"
formation_dest="$HOME/Code/formation"

if [ "$this_dir" != "$formation_dest" ] && [ ! -d "$formation_dest" ]; then
	printf "  Moving formation to ~/Code/formation…\n"
	mv "$this_dir" "$formation_dest"
	printf "  Moved. Re-launching from new location…\n"
	exec "$formation_dest/slay"
fi

###############################################################################
# TWIRL: Check for required functions file
###############################################################################

if [ -e twirl ]; then
	# ./twirl, not twirl: zsh's `.` searches $PATH, not the current folder.
	cd "$(dirname "$0")" \
		&& . ./twirl
else
	printf "\n ⚠️  ./twirl not found  💃🏾 First, you need to twirl on your haters\n"
	exit 1
fi

###############################################################################
# UPDATE: Check for the update-loop + changelog helpers
###############################################################################

if [ -e update ]; then
	. ./update
else
	printf "\n ⚠️  ./update not found  💃🏾 './slay update' won't be available\n"
fi

###############################################################################
# CLI: `./slay`, `./slay update`, `./slay update <name>`, `./slay update --check`
###############################################################################

MODE="install"
UPDATE_ARGS=()
if [ "${1:-}" = "update" ]; then
	MODE="update"
	shift
	UPDATE_ARGS=("$@")
fi

# `--changelogs` prints plain Markdown meant to be redirected to a file -
# the banner/chapter/internet-check chatter below (all on stdout) would
# otherwise land in that file ahead of the Markdown. Route it to stderr
# instead for this one mode so stdout stays clean from the very first byte.
PLAIN_STDOUT=0
if [ "$MODE" = "update" ] && [ "${UPDATE_ARGS[1]:-}" = "--changelogs" ]; then  # zsh arrays start at 1
	PLAIN_STDOUT=1
fi

###############################################################################
# CHECK: zsh version
###############################################################################

check_zsh_version

###############################################################################
# Get in Formation!          http://patorjk.com/software/taag/ ( font: Script )
###############################################################################

if [ "$PLAIN_STDOUT" = "1" ]; then exec 3>&1 1>&2; fi

printf "
   _
  | |
  | |  __   ,_    _  _  _    __, _|_ 🍋  __   _  _
  |/  /  \_/  |  / |/ |/ |  /  |  |  |  /  \_/ |/ |
  |__/\__/    |_/  |  |  |_/\_/|_/|_/|_/\__/   |  |
  |\  ---------------------------------------------
  |/  Cause you slay                     [for zsh 5+]
╭───────────────────────────────────────────────────╮
│  Okay developers now let's get in ${bold}formation${normal}.      │
│───────────────────────────────────────────────────│
│  Safe to run multiple times on the same machine.  │
│  It ${green}installs${reset}, ${blue}upgrades${reset}, or ${yellow}skips${reset} packages based   │
│  on what is already installed on the machine.     │
╰───────────────────────────────────────────────────╯
   ${dim}$(get_os) $(get_os_version) ${normal} // ${dim}$ZSH_NAME ${normal} // ${dim}$ZSH_VERSION${reset}
"

###############################################################################
# STEPS: one file per chapter in ./steps, run in this order
###############################################################################

. "$cwd/steps/internet"

# Restore stdout for the Markdown that `run_update_changelogs` itself
# prints - everything from here on in this mode is `update`'s own careful
# stdout(Markdown)/stderr(progress) split, not this script's normal chatter.
if [ "$PLAIN_STDOUT" = "1" ]; then exec 1>&3 3>&-; fi

# `./slay update` / `./slay update <name>` / `./slay update --check` skip
# straight past every install-only step (sudo caching, SSH, Xcode/Bash-it/
# NVM/Homebrew/brews/casks/apps/pnpm installs, hot sauce) to steps/update.
if [ "$MODE" = "install" ]; then
	for step in \
		password \
		ssh-key \
		dependencies \
		brews \
		brew-update \
		casks \
		app-store \
		brew-cleanup \
		pnpm \
		hot-sauce
	do
		. "$cwd/steps/$step"
	done
fi

. "$cwd/steps/update"

###############################################################################
# 🍋🍋🍋🍋🍋🍋🍋🍋🍋🍋🍋🍋🍋🍋🍋🍋🍋🍋🍋🍋🍋🍋🍋🍋🍋🍋🍋🍋🍋🍋🍋🍋🍋🍋🍋🍋🍋🍋🍋🍋🍋
###############################################################################
e_lemon_ated
