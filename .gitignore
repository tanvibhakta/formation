.claude/settings.local.json

# Never commit secrets
.secrets
*.secrets

# setup.sh symlinks hot-sauce/config/<app> → ~/.config/<app>, so applications
# write their runtime state directly into this repo. That state is machine-local
# and must never be tracked.
#
# gh CLI writes auth tokens to hosts.yml.
hot-sauce/config/gh/hosts.yml
hot-sauce/config/gh/*.backup
# Zed's prompt library: an LMDB database plus a live lock file.
hot-sauce/config/zed/prompts/

# Claude Code's skills sync writes its bucket state and deleted-skill trash under
# ~/.claude/skills, which is this repo. Both are runtime state.
hot-sauce/claude/skills/.trash/
hot-sauce/claude/skills/synced/

# Per-machine Ghostty overrides, pulled in via `config-file = ?local.conf`.
# Deliberately untracked so it never travels between laptops.
hot-sauce/config/ghostty/local.conf
