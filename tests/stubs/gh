#!/bin/bash
. "${0%/*}/_log"
# `gh api <path> [--jq expr]`: serves $FAKE/gh/<path with / ? & = turned into _>.
# Missing file → exit 1, like a 404.
[ "$1" = "api" ] || exit 0
path="$2"; shift 2
f="$FAKE/gh/$(printf '%s' "$path" | tr '/?&=' '____')"
[ -f "$f" ] || exit 1
if [ "$1" = "--jq" ]; then jq -r "$2" "$f"; else cat "$f"; fi
